# Copy this file to .env and adjust the user and password of your local PostgreSQL.
# With no password, use postgresql://USER@localhost:5432/...
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pt_grupo05_dev?schema=public"

# Random string with at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME"

# For the e2e tests, create .env.test with the same two variables, pointing
# DATABASE_URL to a database whose name ends with _test (e.g. pt_grupo05_test).
