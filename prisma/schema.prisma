// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuarios {
  id            Int      @id @default(autoincrement())
  username      String   @db.VarChar(50)
  nome          String   @db.VarChar(255)
  email         String   @db.VarChar(255)
  senhaHash     String   @db.VarChar(255)
  fotoPerfilUrl String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lojas                 Lojas[]
  avaliacoesLoja        AvaliacoesLoja[]
  avaliacoesProduto     AvaliacoesProduto[]
  comentariosAvaliacoes ComentariosAvaliacoes[]
}

model Lojas {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  nome       String   @db.VarChar(255)
  descricao  String?
  logoUrl    String?  @db.VarChar(255)
  bannerUrl  String?  @db.VarChar(255)
  stickerUrl String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  usuario    Usuarios         @relation(fields: [usuarioId], references: [id])
  produtos   Produtos[]
  avaliacoes AvaliacoesLoja[]
}

model Categorias {
  id             Int    @id @default(autoincrement())
  nome           String @db.VarChar(100)
  categoriaPaiId Int?

  categoriaPai  Categorias?  @relation("CategoriaPai", fields: [categoriaPaiId], references: [id])
  subcategorias Categorias[] @relation("CategoriaPai")
  produtos      Produtos[]
}

model Produtos {
  id          Int      @id @default(autoincrement())
  lojaId      Int
  categoriaId Int
  nome        String   @db.VarChar(255)
  descricao   String?
  preco       Decimal  @db.Decimal(10, 2)
  estoque     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loja       Lojas               @relation(fields: [lojaId], references: [id])
  categoria  Categorias          @relation(fields: [categoriaId], references: [id])
  imagens    ImagensProduto[]
  avaliacoes AvaliacoesProduto[]
}

model ImagensProduto {
  id        Int    @id @default(autoincrement())
  produtoId Int
  urlImagem String @db.VarChar(255)
  ordem     Int?

  produto Produtos @relation(fields: [produtoId], references: [id])
}

model AvaliacoesLoja {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  lojaId     Int
  nota       Int
  comentario String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  usuario     Usuarios                @relation(fields: [usuarioId], references: [id])
  loja        Lojas                   @relation(fields: [lojaId], references: [id])
  comentarios ComentariosAvaliacoes[]
}

model AvaliacoesProduto {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  produtoId  Int
  nota       Int
  comentario String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  usuario     Usuarios                @relation(fields: [usuarioId], references: [id])
  produto     Produtos                @relation(fields: [produtoId], references: [id])
  comentarios ComentariosAvaliacoes[]
}

model ComentariosAvaliacoes {
  id                 Int      @id @default(autoincrement())
  usuarioId          Int
  avaliacaoLojaId    Int?
  avaliacaoProdutoId Int?
  conteudo           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  usuario          Usuarios           @relation(fields: [usuarioId], references: [id])
  avaliacaoLoja    AvaliacoesLoja?    @relation(fields: [avaliacaoLojaId], references: [id])
  avaliacaoProduto AvaliacoesProduto? @relation(fields: [avaliacaoProdutoId], references: [id])
}
